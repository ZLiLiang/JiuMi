<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fac="using:FluentAvalonia.UI.Controls">

  <Style Selector="Border.island">
    <Setter Property="Background" Value="{DynamicResource JiuMiIslandBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JiuMiIslandBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource JiuMiIslandShadow}" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ListBox.nav fac|FASymbolIcon.nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem TextBlock.nav-label">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="ListBox.nav fac|FASymbolIcon.nav-icon-selected">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:selected fac|FASymbolIcon.nav-icon-outline">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:selected fac|FASymbolIcon.nav-icon-selected">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:selected fac|FASymbolIcon.nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:disabled fac|FASymbolIcon.nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
  </Style>

  <Style Selector="ListBox.nav ListBoxItem:disabled TextBlock.nav-label">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
  </Style>

  <Style Selector="ListBox.nav.collapsed ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Label}" />
  </Style>

  <Style Selector="ListBox.nav.collapsed Grid.nav-text">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ListBox.nav.collapsed Grid.nav-content">
    <Setter Property="ColumnSpacing" Value="0" />
  </Style>

  <Style Selector="ListBox.nav.collapsed fac|FASymbolIcon.nav-icon">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

</Styles>
