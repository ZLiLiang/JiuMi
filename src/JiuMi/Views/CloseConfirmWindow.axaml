<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JiuMi.ViewModels"
        x:Class="JiuMi.Views.CloseConfirmWindow"
        x:DataType="vm:CloseConfirmWindowViewModel"
        Title="{Binding AppName}"
        Width="420"
        Height="240"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.headline">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="28" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.dialog">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </Window.Styles>

  <Border Classes="island" Margin="8" Padding="24">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Classes="headline"
                 Text="{Binding Heading}" />

      <TextBlock Grid.Row="1"
                 Margin="0,8,0,0"
                 Classes="body"
                 Text="{Binding Body}" />

      <CheckBox Grid.Row="2"
                Margin="0,14,0,0"
                VerticalAlignment="Top"
                FontSize="13"
                Content="{Binding DontAskText}"
                IsChecked="{Binding DontAsk, Mode=TwoWay}" />

      <StackPanel Grid.Row="3"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button Classes="dialog"
                IsCancel="True"
                Content="{Binding CancelText}"
                Click="OnCancelClick" />
        <Button Classes="dialog danger"
                Content="{Binding ExitText}"
                Click="OnExitClick" />
        <Button Name="MinimizeButton"
                Classes="dialog accent"
                IsDefault="True"
                Content="{Binding MinimizeToTrayText}"
                Click="OnMinimizeClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
