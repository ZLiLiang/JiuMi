<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fac="using:FluentAvalonia.UI.Controls"
             xmlns:fr="using:JiuMi.Application.FileRename"
             xmlns:loc="using:JiuMi.Localization"
             xmlns:vm="using:JiuMi.ViewModels"
             x:Class="JiuMi.Views.FileRenameView"
             x:DataType="vm:FileRenameViewModel"
             DragDrop.AllowDrop="True"
             DragDrop.DragEnter="OnDragEnter"
             DragDrop.DragOver="OnDragOver"
             DragDrop.DragLeave="OnDragLeave"
             DragDrop.Drop="OnDrop">
  <UserControl.Styles>
    <Style Selector="TextBlock.param-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.segment.active">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.label-help">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.label-help:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.row-status">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.row-status TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.row-status.done">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellWorkingBrush}" />
    </Style>
    <Style Selector="Border.row-status.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.row-status.conflict">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row-status.conflict TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Border.row-status.failed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row-status.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Border.row-status.skip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.row.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon-small">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.icon-small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.skip-toggle">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.skip-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border x:Name="PageBorder" Padding="44,32,44,36">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{loc:Localize Tool.FileRename.Name}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{loc:Localize Tool.FileRename.Subtitle}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Top">
            <Button Height="32"
                    Padding="12,0"
                    IsEnabled="{Binding IsIdle}"
                    Click="OnPickFolderClick"
                    AutomationProperties.AutomationId="FileRename.PickFolder">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fac:FASymbolIcon FontSize="14"
                                  VerticalAlignment="Center"
                                  Symbol="Folder"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="13"
                           VerticalAlignment="Center"
                           Text="{loc:Localize Tool.FileRename.Pick}" />
              </StackPanel>
            </Button>
            <Button Height="32"
                    Padding="12,0"
                    Classes="accent"
                    Content="{loc:Localize Tool.FileRename.Action.Run}"
                    IsEnabled="{Binding CanRun}"
                    Click="OnRunClick"
                    AutomationProperties.AutomationId="FileRename.Run" />
            <Button Classes="help"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Localize Tool.FileRename.Help}"
                    AutomationProperties.Name="{loc:Localize Tool.FileRename.Help}">
              <TextBlock FontSize="11"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="?" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Border Grid.Row="1"
                  Margin="0,22,0,0"
                  Padding="20"
                  CornerRadius="8"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding ShowEmptyState}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Border Width="56"
                      Height="56"
                      Margin="0,0,0,14"
                      CornerRadius="12"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <fac:FASymbolIcon Symbol="Folder"
                                  FontSize="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </Border>
              <TextBlock FontSize="14"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Text="{loc:Localize Tool.FileRename.Empty}" />
              <TextBlock MaxWidth="380"
                         Margin="0,6,0,0"
                         FontSize="12"
                         LineHeight="19"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{loc:Localize Tool.FileRename.Empty.Hint}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1"
                  Margin="0,22,0,0"
                  Padding="20"
                  CornerRadius="8"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding HasDirectory}">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
              <StackPanel Grid.Row="0">
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,20,12">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Target}" />
                    <Border Margin="0,4,0,0"
                            Padding="2"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="segment"
                                Classes.active="{Binding IsFilesMode}"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="{x:Static fr:RenameTarget.Files}"
                                Content="{loc:Localize Tool.FileRename.Target.Files}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Classes="segment"
                                Classes.active="{Binding IsFoldersMode}"
                                Command="{Binding SetTargetCommand}"
                                CommandParameter="{x:Static fr:RenameTarget.Folders}"
                                Content="{loc:Localize Tool.FileRename.Target.Folders}"
                                IsEnabled="{Binding IsIdle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Rule}" />
                    <Border Margin="0,4,0,0"
                            Padding="2"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="segment"
                                Classes.active="{Binding IsBasicLevel}"
                                Command="{Binding SetLevelCommand}"
                                CommandParameter="{x:Static fr:RenameRuleLevel.Basic}"
                                Content="{loc:Localize Tool.FileRename.Level.Basic}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Classes="segment"
                                Classes.active="{Binding IsAdvancedLevel}"
                                Command="{Binding SetLevelCommand}"
                                CommandParameter="{x:Static fr:RenameRuleLevel.Advanced}"
                                Content="{loc:Localize Tool.FileRename.Level.Advanced}"
                                IsEnabled="{Binding IsIdle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Scope.Subdirectories}" />
                    <ToggleSwitch Margin="0,8,0,0"
                                  OnContent=""
                                  OffContent=""
                                  IsEnabled="{Binding IsIdle}"
                                  IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Localize Tool.FileRename.Scope.Subdirectories}" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowExtensionFilter}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Scope.Extensions}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Scope.Extensions.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Scope.Extensions.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <TextBox Width="150"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             PlaceholderText="{loc:Localize Tool.FileRename.Scope.Extensions.Placeholder}"
                             Text="{Binding Extensions, Mode=TwoWay}" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Backup}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Backup.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Backup.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <ToggleSwitch Margin="0,8,0,0"
                                  OnContent=""
                                  OffContent=""
                                  IsEnabled="{Binding IsIdle}"
                                  IsChecked="{Binding BackupEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Localize Tool.FileRename.Backup}" />
                  </StackPanel>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsBasicLevel}">
                  <StackPanel Margin="0,0,20,12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Task.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Task.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <ComboBox Width="132"
                              Height="32"
                              Margin="0,4,0,0"
                              IsEnabled="{Binding IsIdle}"
                              ItemsSource="{Binding BasicTaskNames}"
                              SelectedIndex="{Binding SelectedBasicTaskIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="FileRename.BasicTask" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicReplaceFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Find}" />
                    <TextBox Width="180"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding BasicFind, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicReplaceFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Replace}" />
                    <TextBox Width="200"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding BasicReplace, Mode=TwoWay}" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicAffixFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task.Affix.Position}" />
                    <Border Margin="0,4,0,0"
                            Padding="2"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="segment"
                                Classes.active="{Binding IsAffixPrefix}"
                                Command="{Binding SetAffixPositionCommand}"
                                CommandParameter="{x:Static fr:RenameAffixPosition.Prefix}"
                                Content="{loc:Localize Tool.FileRename.Task.Affix.Prefix}"
                                IsEnabled="{Binding IsIdle}" />
                        <Button Classes="segment"
                                Classes.active="{Binding IsAffixSuffix}"
                                Command="{Binding SetAffixPositionCommand}"
                                CommandParameter="{x:Static fr:RenameAffixPosition.Suffix}"
                                Content="{loc:Localize Tool.FileRename.Task.Affix.Suffix}"
                                IsEnabled="{Binding IsIdle}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicAffixFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task.Affix.Text}" />
                    <TextBox Width="160"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding AffixText, Mode=TwoWay}" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicSequenceFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task.Sequence.Name}" />
                    <TextBox Width="150"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             PlaceholderText="{Binding SequenceNamePlaceholder}"
                             Text="{Binding SequenceName, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowBasicSequenceFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task.Sequence.Pad}" />
                    <ComboBox Width="120"
                              Height="32"
                              Margin="0,4,0,0"
                              IsEnabled="{Binding IsIdle}"
                              ItemsSource="{Binding PadNames}"
                              SelectedIndex="{Binding SelectedPadIndex, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsAdvancedLevel}">
                  <StackPanel Margin="0,0,20,12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Task}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Rule.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Rule.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <ComboBox Width="132"
                              Height="32"
                              Margin="0,4,0,0"
                              IsEnabled="{Binding IsIdle}"
                              ItemsSource="{Binding AdvancedKindNames}"
                              SelectedIndex="{Binding SelectedAdvancedKindIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="FileRename.AdvancedKind" />
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowAdvancedReplaceFields}">
                    <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Find}" />
                    <TextBox Width="180"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding AdvancedFind, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowAdvancedReplaceFields}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Replace}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Replace.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Replace.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                      <TextBox Width="200"
                               Height="32"
                               IsEnabled="{Binding IsIdle}"
                               Text="{Binding AdvancedReplace, Mode=TwoWay}" />
                      <CheckBox Content="{loc:Localize Tool.FileRename.Regex}"
                                IsEnabled="{Binding IsIdle}"
                                IsChecked="{Binding AdvancedUseRegex, Mode=TwoWay}"
                                ToolTip.Tip="{loc:Localize Tool.FileRename.Regex.Help}"
                                AutomationProperties.Name="{loc:Localize Tool.FileRename.Regex.Help}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Margin="0,0,20,12" IsVisible="{Binding ShowAdvancedTemplateFields}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="param-label" Text="{loc:Localize Tool.FileRename.Template}" />
                      <Button Classes="label-help"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Localize Tool.FileRename.Template.Help}"
                              AutomationProperties.Name="{loc:Localize Tool.FileRename.Template.Help}">
                        <TextBlock FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="?" />
                      </Button>
                    </StackPanel>
                    <TextBox Width="300"
                             Height="32"
                             Margin="0,4,0,0"
                             IsEnabled="{Binding IsIdle}"
                             Text="{Binding Template, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>

              <Border Grid.Row="1"
                      Height="1"
                      Margin="0,4,0,0"
                      Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

              <Border Grid.Row="2"
                      Margin="0,10,0,10"
                      Padding="8,10"
                      CornerRadius="4"
                      IsVisible="{Binding HasPrecheckErrors}"
                      Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                      BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                      BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Ellipse Grid.Column="0"
                           Width="8"
                           Height="8"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                  <TextBlock Grid.Column="1"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding PrecheckSummaryText}" />
                  <TextBlock Grid.Column="2"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{Binding PrecheckReasonText}" />
                </Grid>
              </Border>

              <Grid Grid.Row="3" RowDefinitions="Auto,*">
                <Grid Margin="8,8,8,6" ColumnDefinitions="*,18,*,92" ColumnSpacing="12">
                  <TextBlock Grid.Column="0"
                             FontSize="11"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.FileRename.List.Original}" />
                  <TextBlock Grid.Column="2"
                             FontSize="11"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.FileRename.List.Target}" />
                  <TextBlock Grid.Column="3"
                             FontSize="11"
                             HorizontalAlignment="Right"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.FileRename.List.Status}" />
                </Grid>

                <TextBlock Grid.Row="1"
                           IsVisible="{Binding ShowListEmpty}"
                           Margin="16,0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding ListEmptyText}" />

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding !ShowListEmpty}"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileRenameRowViewModel">
                        <Border Padding="8,9"
                                MinHeight="44"
                                Classes="row"
                                Classes.last="{Binding IsLast}">
                          <Grid ColumnDefinitions="*,18,*,92" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding OriginalDisplay}" />
                            <Viewbox Grid.Column="1"
                                     Width="12"
                                     Height="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                              <Path Data="M3,8 L13,8 M9,4 L13,8 L9,12"
                                    Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                    StrokeThickness="1.3"
                                    StrokeLineCap="Round"
                                    StrokeJoin="Round" />
                            </Viewbox>
                            <StackPanel Grid.Column="2" ClipToBounds="True">
                              <StackPanel Orientation="Horizontal" IsVisible="{Binding !TargetIsInvalid}">
                                <TextBlock FontSize="13" Text="{Binding DiffPrefix}" />
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           Text="{Binding DiffChanged}" />
                                <TextBlock FontSize="13" Text="{Binding DiffSuffix}" />
                              </StackPanel>
                              <TextBlock FontSize="13"
                                         IsVisible="{Binding TargetIsInvalid}"
                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                         Text="{Binding TargetDisplay}" />
                              <TextBlock Margin="0,2,0,0"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasReason}"
                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                         Text="{Binding ReasonText}" />
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Classes="row-status"
                                    Classes.pending="{Binding IsPending}"
                                    Classes.conflict="{Binding IsConflict}"
                                    Classes.done="{Binding IsDone}"
                                    Classes.failed="{Binding IsFailedOrUndoFailed}"
                                    Margin="0,0,7,0">
                              <TextBlock Text="{Binding StatusText}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <Border Grid.Row="4"
                      IsVisible="{Binding IsSkipPanelVisible}"
                      Margin="0,4,0,0"
                      Padding="0,4,0,0"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SkippedRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileRenameSkipRowViewModel">
                        <Grid Height="32" ColumnDefinitions="*,92" ColumnSpacing="12">
                          <TextBlock FontSize="12"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="{Binding DisplayName}" />
                          <Border Grid.Column="1" Classes="row-status skip" Margin="0,0,7,0">
                            <TextBlock Text="{Binding ReasonText}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <Border Grid.Row="5"
                      Margin="0,12,0,0"
                      Padding="0,12,0,0"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StatsText}" />
                    <Button Classes="skip-toggle"
                            IsVisible="{Binding HasSkipItems}"
                            Command="{Binding ToggleSkipCommand}"
                            AutomationProperties.AutomationId="FileRename.SkipToggle">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <fac:FASymbolIcon FontSize="10"
                                          VerticalAlignment="Center"
                                          Symbol="ChevronRight"
                                          IsVisible="{Binding !IsSkipPanelOpen}" />
                        <fac:FASymbolIcon FontSize="10"
                                          VerticalAlignment="Center"
                                          Symbol="ChevronDown"
                                          IsVisible="{Binding IsSkipPanelOpen}" />
                        <TextBlock FontSize="12" Text="{Binding SkipCountText}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <Button Classes="icon-small"
                            IsEnabled="{Binding CanExport}"
                            Click="OnExportClick"
                            ToolTip.Tip="{loc:Localize Tool.FileRename.Action.Export}"
                            AutomationProperties.Name="{loc:Localize Tool.FileRename.Action.Export}">
                      <fac:FASymbolIcon FontSize="14" Symbol="Save" />
                    </Button>
                    <Button Height="32"
                            Padding="12,0"
                            Content="{loc:Localize Tool.FileRename.Action.Undo}"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            AutomationProperties.AutomationId="FileRename.Undo" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="DropOverlay"
            Margin="28"
            CornerRadius="10"
            IsVisible="False"
            IsHitTestVisible="False"
            BorderThickness="2"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
      <TextBlock FontSize="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Text="{loc:Localize Tool.FileRename.Drop.Hint}" />
    </Border>
  </Grid>
</UserControl>
