<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:JiuMi.Localization"
             xmlns:my="using:JiuMi.Application.MyJiuMi"
             xmlns:vm="using:JiuMi.ViewModels"
             x:Class="JiuMi.Views.MyJiuMiView"
             x:DataType="vm:MyJiuMiViewModel">
  <Border Padding="44,32,44,36">
    <Grid RowDefinitions="Auto,*">
      <StackPanel>
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{loc:Localize MyJiuMi.Title}" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="{loc:Localize MyJiuMi.Subtitle}" />
      </StackPanel>

      <Border Grid.Row="1"
              Margin="0,22,0,0"
              MinHeight="380"
              CornerRadius="12"
              ClipToBounds="True"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid x:Name="Room"
              RowDefinitions="*,1,72"
              Background="Transparent"
              DoubleTapped="OnRoomDoubleTapped">
          <Grid x:Name="RoomWall"
                Grid.Row="0"
                ClipToBounds="True"
                Background="Transparent"
                SizeChanged="OnRoomWallSizeChanged">
            <Grid x:Name="CatRoot"
                  Width="{x:Static my:MyJiuMiInteractionRules.CatSize}"
                  Height="{x:Static my:MyJiuMiInteractionRules.CatSize}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="{Binding CatMargin}">
              <Ellipse Width="120"
                       Height="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Fill="#22000000"
                       IsHitTestVisible="False" />
              <Image x:Name="CatImage"
                     Stretch="Uniform"
                     Source="{Binding Frame}"
                     IsVisible="{Binding IsCatVisible}"
                     IsHitTestVisible="False"
                     RenderTransformOrigin="50%,50%"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     AutomationProperties.Name="{loc:Localize MyJiuMi.Cat.AutomationName}" />
              <Path Width="20"
                    Height="18"
                    Margin="0,54,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IsHeartVisible}"
                    IsHitTestVisible="False"
                    Fill="#E85D75"
                    Stretch="Uniform"
                    Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" />
              <TextBlock Margin="0,58,30,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsVisible="{Binding IsZzzVisible}"
                         IsHitTestVisible="False"
                         FontSize="15"
                         FontStyle="Italic"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="Zzz" />
              <Border x:Name="CatHitArea"
                      Height="140"
                      VerticalAlignment="Bottom"
                      Background="Transparent"
                      PointerPressed="OnCatPointerPressed"
                      PointerMoved="OnCatPointerMoved"
                      PointerReleased="OnCatPointerReleased"
                      PointerCaptureLost="OnCatPointerCaptureLost" />
            </Grid>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
          <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
