<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:JiuMi.Localization"
        xmlns:my="using:JiuMi.MyJiuMi"
        xmlns:pet="using:JiuMi.Application.MyJiuMi"
        x:Class="JiuMi.Views.MyJiuMiDesktopWindow"
        x:DataType="my:MyJiuMiSession"
        Width="{x:Static pet:MyJiuMiTransitionRules.DesktopSizeDip}"
        Height="{x:Static pet:MyJiuMiTransitionRules.DesktopSizeDip}"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
  <Grid x:Name="CatRoot"
        Background="Transparent"
        RenderTransformOrigin="50%,100%"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerCaptureLost="OnPointerCaptureLost"
        DoubleTapped="OnDoubleTapped">
    <Image x:Name="CatImage"
           Stretch="Uniform"
           RenderOptions.BitmapInterpolationMode="HighQuality"
           RenderTransformOrigin="50%,50%"
           Source="{Binding Frame}"
           IsVisible="{Binding IsFrameVisible}"
           IsHitTestVisible="False"
           AutomationProperties.Name="{loc:Localize MyJiuMi.Cat.AutomationName}" />
    <Path Width="16"
          Height="14"
          Margin="0,43,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsVisible="{Binding IsHeartVisible}"
          IsHitTestVisible="False"
          Fill="#E85D75"
          Stretch="Uniform"
          Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" />
    <TextBlock Margin="0,46,24,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               IsVisible="{Binding IsZzzVisible}"
               IsHitTestVisible="False"
               FontSize="12"
               FontStyle="Italic"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Text="Zzz" />
  </Grid>
</Window>
