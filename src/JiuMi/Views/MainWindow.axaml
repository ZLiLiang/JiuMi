<fa:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:fa="using:FluentAvalonia.UI.Windowing"
                 xmlns:fac="using:FluentAvalonia.UI.Controls"
                 xmlns:loc="using:JiuMi.Localization"
                 xmlns:views="using:JiuMi.Views"
                 xmlns:vm="using:JiuMi.ViewModels"
                 x:Class="JiuMi.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="{Binding AppName}"
                 Width="1200"
                 Height="760"
                 MinWidth="900"
                 MinHeight="600"
                 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 TransparencyLevelHint="Mica">
  <fa:FAAppWindow.Resources>
    <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:ShellNavigationItem">
      <Grid Classes="nav-content" ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <fac:FASymbolIcon Grid.Column="0"
                          Classes="nav-icon nav-icon-outline"
                          FontSize="16"
                          VerticalAlignment="Center"
                          Symbol="{Binding IconName, Converter={x:Static loc:SymbolNameConverter.Instance}}" />
        <fac:FASymbolIcon Grid.Column="0"
                          Classes="nav-icon nav-icon-selected"
                          FontSize="16"
                          VerticalAlignment="Center"
                          Symbol="{Binding SelectedIconName, Converter={x:Static loc:SymbolNameConverter.Instance}}" />
        <Grid Grid.Column="1" Classes="nav-text" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     Classes="nav-label"
                     VerticalAlignment="Center"
                     FontSize="14"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Label}" />
          <ContentControl Grid.Column="1"
                          Classes="nav-badge"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsComingSoon}"
                          Theme="{StaticResource ComingSoonBadgeTheme}"
                          Content="{loc:Localize Common.ComingSoon}" />
        </Grid>
      </Grid>
    </DataTemplate>
  </fa:FAAppWindow.Resources>

  <Grid RowDefinitions="40,*">
    <Border x:Name="BackdropHighlight"
            Grid.RowSpan="2"
            Background="{DynamicResource JiuMiWindowHighlightBrush}"
            IsHitTestVisible="False"
            IsVisible="False" />

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="16,0" Background="Transparent">
      <Border x:Name="TitleBarMark"
              Width="18"
              Height="18"
              CornerRadius="4"
              VerticalAlignment="Center">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
            <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark1}" />
          </LinearGradientBrush>
        </Border.Background>
        <Image x:Name="TitleBarIcon"
               Stretch="UniformToFill"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </Border>
      <TextBlock Grid.Column="1"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{Binding AppName}" />
    </Grid>

    <Grid Grid.Row="1" Margin="14" ColumnDefinitions="Auto,14,*">
      <Border Grid.Column="0"
              Classes="island"
              Width="{Binding NavigationWidth}"
              Padding="8,8,8,12">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Button Grid.Row="0"
                  Width="36"
                  Height="32"
                  Margin="0,0,0,8"
                  Padding="0"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="4"
                  Command="{Binding ToggleNavigationCommand}"
                  AutomationProperties.Name="{Binding ToggleNavigationAccessibleName}">
            <fac:FASymbolIcon Symbol="List"
                              FontSize="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Button>

          <ListBox Grid.Row="1"
                   Classes="nav"
                   Classes.collapsed="{Binding IsNavigationCollapsed}"
                   VerticalAlignment="Top"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ItemsSource="{Binding PrimaryNavigationItems}"
                   ItemTemplate="{StaticResource NavigationItemTemplate}"
                   ItemContainerTheme="{StaticResource NavigationItemTheme}"
                   SelectedItem="{Binding SelectedPrimaryItem, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <Border Grid.Row="2"
                  Height="1"
                  Margin="6,12"
                  Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

          <ListBox Grid.Row="3"
                   Classes="nav"
                   Classes.collapsed="{Binding IsNavigationCollapsed}"
                   VerticalAlignment="Bottom"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ItemsSource="{Binding SettingsNavigationItems}"
                   ItemTemplate="{StaticResource NavigationItemTemplate}"
                   ItemContainerTheme="{StaticResource NavigationItemTheme}"
                   SelectedItem="{Binding SelectedSettingsItem, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="island">
        <DockPanel>
          <views:InfoBarView DockPanel.Dock="Top" DataContext="{Binding InfoBar}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentPage}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</fa:FAAppWindow>
