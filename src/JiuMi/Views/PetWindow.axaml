<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:JiuMi.Localization"
        x:Class="JiuMi.Views.PetWindow"
        WindowDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
  <Grid Background="Transparent"
        ToolTip.Tip="{loc:Localize Shell.Pet.ToolTip}"
        AutomationProperties.Name="{loc:Localize Shell.Pet.AutomationName}">
    <Image x:Name="Frame"
           Stretch="Uniform"
           RenderTransformOrigin="50%,50%"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch" />
    <Path x:Name="Heart"
          Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.03 L12,21.35 Z"
          Width="28"
          Height="26"
          Stretch="Uniform"
          Fill="{DynamicResource SystemFillColorCriticalBrush}"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="0,8,0,0"
          IsVisible="False"
          IsHitTestVisible="False" />
    <TextBlock x:Name="SleepMarks"
               Text="{loc:Localize Shell.Pet.SleepMarks}"
               FontSize="17"
               FontWeight="SemiBold"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,14,18,0"
               IsVisible="False"
               IsHitTestVisible="False" />
  </Grid>
</Window>
