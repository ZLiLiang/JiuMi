<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:JiuMi.Localization"
             xmlns:fac="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:JiuMi.ViewModels"
             xmlns:wc="using:JiuMi.Application.WorldClock"
             x:Class="JiuMi.Views.WorldClockView"
             x:DataType="vm:WorldClockViewModel">
  <UserControl.Styles>
    <Style Selector="Button.segment">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.segment.active">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.dial-chip">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status-chip">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status-chip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.status-chip.working">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellWorkingBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JiuMiCellWorkingBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.status-chip.working TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.status-chip.holiday">
      <Setter Property="BorderBrush" Value="{DynamicResource JiuMiDayBreakBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.status-chip.holiday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.swatch.work">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellWorkingBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JiuMiCellWorkingBorderBrush}" />
    </Style>
    <Style Selector="Border.swatch.off">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellOffBrush}" />
    </Style>
    <Style Selector="Border.swatch.weekend">
      <Setter Property="Background" Value="{DynamicResource JiuMiWeekendHatchBrush}" />
    </Style>
    <Style Selector="Border.swatch.holiday">
      <Setter Property="Background" Value="{DynamicResource JiuMiHolidayHatchBrush}" />
    </Style>
    <Style Selector="Border.band-cell">
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource JiuMiOverlapBandBrush}" />
    </Style>
    <Style Selector="Border.band-cell.zero">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellOffBrush}" />
    </Style>
    <Style Selector="Border.plan-cell">
      <Setter Property="Height" Value="50" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource JiuMiCellOffBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.plan-cell.night">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellNightBrush}" />
    </Style>
    <Style Selector="Border.plan-cell.working">
      <Setter Property="Background" Value="{DynamicResource JiuMiCellWorkingBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JiuMiCellWorkingBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.plan-cell.unavailable">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.hatch">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.hatch.weekend">
      <Setter Property="Background" Value="{DynamicResource JiuMiWeekendHatchBrush}" />
    </Style>
    <Style Selector="Border.hatch.holiday">
      <Setter Property="Background" Value="{DynamicResource JiuMiHolidayHatchBrush}" />
    </Style>
    <Style Selector="TextBlock.row-time">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.row-time.working">
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.meta-en">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.footnote">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.footnote.warning">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Button.help">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="44,32,44,36">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel>
          <TextBlock FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Text="{loc:Localize Tool.WorldClock.Name}" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{loc:Localize Tool.WorldClock.Subtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
          <Border Padding="2"
                  CornerRadius="4"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment"
                      Classes.active="{Binding IsBoardView}"
                      Command="{Binding SetViewCommand}"
                      CommandParameter="{x:Static wc:WorldClockViewMode.Board}"
                      Content="{loc:Localize Tool.WorldClock.View.Board}" />
              <Button Classes="segment"
                      Classes.active="{Binding IsPlanView}"
                      Command="{Binding SetViewCommand}"
                      CommandParameter="{x:Static wc:WorldClockViewMode.Plan}"
                      Content="{loc:Localize Tool.WorldClock.View.Plan}" />
            </StackPanel>
          </Border>
          <Button Command="{Binding ManagePlacesCommand}"
                  AutomationProperties.Name="{loc:Localize Tool.WorldClock.ManagePlaces}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="+" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Localize Tool.WorldClock.ManagePlaces}"
                         FontSize="13"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Margin="0,22,0,0"
              Padding="24"
              CornerRadius="8"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="8">
          <TextBlock FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Text="{loc:Localize Tool.WorldClock.Empty}" />
          <TextBlock FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{loc:Localize Tool.WorldClock.Empty.Hint}" />
          <Button Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Command="{Binding ManagePlacesCommand}"
                  AutomationProperties.Name="{loc:Localize Tool.WorldClock.ManagePlaces}"
                  Content="{loc:Localize Tool.WorldClock.ManagePlaces}" />
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding !ShowEmptyState}">
        <Border Margin="0,22,0,0"
                Padding="20,18,20,20"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                IsVisible="{Binding IsBoardView}">
          <StackPanel>
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding SummaryText}" />

            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorldClockRowViewModel">
                  <StackPanel>
                    <Grid ColumnDefinitions="190,*,Auto" ColumnSpacing="16" Margin="0,10">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="14"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Text="{Binding PrimaryName}" />
                          <Border Classes="dial-chip" IsVisible="{Binding HasDialCode}">
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding DialCode}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="meta-en" Text="{Binding SecondaryName}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="10"
                                  VerticalAlignment="Center">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding LocalTimeText}" />
                        <TextBlock FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding WeekdayText}" />
                      </StackPanel>
                      <Border Grid.Column="2"
                              Classes="status-chip"
                              Classes.working="{Binding IsWorkingStatus}"
                              Classes.holiday="{Binding IsHolidayStatus}">
                        <TextBlock Text="{Binding StatusText}" />
                      </Border>
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            IsVisible="{Binding !IsLast}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,12,0,0"
                        Spacing="2"
                        IsVisible="{Binding HasTimelineNotes}">
              <TextBlock Classes="footnote warning"
                         IsVisible="{Binding HasZoneNote}"
                         Text="{Binding ZoneNote}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          IsVisible="{Binding HasHolidayNote}">
                <TextBlock Classes="footnote warning" Text="{Binding HolidayNote}" />
                <HyperlinkButton FontSize="11"
                                 IsVisible="{Binding CanRetryHolidays}"
                                 Command="{Binding RetryHolidaysCommand}"
                                 Content="{loc:Localize Common.Retry}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Margin="0,22,0,0"
                Padding="20,18,20,20"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                IsVisible="{Binding IsPlanView}">
          <StackPanel>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right"
                      Classes="help"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="{loc:Localize Tool.WorldClock.Footnote.Help}"
                      ToolTip.Tip="{Binding TimelineHelpText}">
                <TextBlock Text="?"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Button>
              <WrapPanel DockPanel.Dock="Right"
                         Margin="12,0,0,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,2">
                  <Border Classes="swatch work" />
                  <TextBlock FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.WorldClock.Legend.Working}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,2">
                  <Border Classes="swatch off" />
                  <TextBlock FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.WorldClock.Legend.Off}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,2">
                  <Border Classes="swatch weekend" />
                  <TextBlock FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.WorldClock.Legend.Weekend}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,2">
                  <Border Classes="swatch holiday" />
                  <TextBlock FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Text="{loc:Localize Tool.WorldClock.Legend.Holiday}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock FontSize="14"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Text="{Binding SummaryText}" />
            </DockPanel>

            <Grid Margin="0,14,0,0" ColumnDefinitions="176,*">
              <Grid RowDefinitions="18,Auto,Auto">
                <TextBlock Grid.Row="1"
                           Margin="0,4,10,0"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{loc:Localize Tool.WorldClock.Overlap}" />
                <ItemsControl Grid.Row="2"
                              Margin="0,6,0,0"
                              ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldClockRowViewModel">
                      <StackPanel Height="50"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="13"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Text="{Binding PrimaryName}" />
                          <Border Classes="dial-chip" IsVisible="{Binding HasDialCode}">
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding DialCode}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="meta-en" Text="{Binding SecondaryName}" />
                        <TextBlock Classes="row-time"
                                   Classes.working="{Binding IsWorkingStatus}"
                                   Text="{Binding LocalTimeLine}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <ScrollViewer Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="18,Auto,Auto" MinWidth="382">
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding Ticks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="24" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorldClockTickViewModel">
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Grid.Row="1"
                                Margin="0,4,0,0"
                                Height="18"
                                ItemsSource="{Binding BandCells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="24" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorldClockBandCellViewModel">
                        <Border Classes="band-cell"
                                Classes.zero="{Binding IsZero}"
                                Opacity="{Binding Opacity}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl Grid.Row="2"
                                Margin="0,6,0,0"
                                x:Name="TimelineRows"
                                ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorldClockRowViewModel">
                        <ItemsControl Height="50" ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="24" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorldClockCellViewModel">
                              <Border Margin="0,0,2,0"
                                      Classes="plan-cell"
                                      Classes.night="{Binding IsNight}"
                                      Classes.working="{Binding IsWorking}"
                                      Classes.unavailable="{Binding IsUnavailable}"
                                      ClipToBounds="True">
                                <Panel>
                                  <Border Classes="hatch weekend" IsVisible="{Binding IsWeekend}" />
                                  <Border Classes="hatch holiday" IsVisible="{Binding IsHoliday}" />
                                  <Rectangle Width="1"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Stretch"
                                             Fill="Transparent"
                                             Stroke="{DynamicResource JiuMiDayBreakBrush}"
                                             StrokeThickness="1"
                                             StrokeDashArray="2,2"
                                             IsVisible="{Binding IsDayBreak}" />
                                </Panel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Canvas Grid.RowSpan="3"
                          x:Name="TimelineOverlay"
                          IsHitTestVisible="False">
                    <Border x:Name="CursorBand"
                            Background="{DynamicResource JiuMiCursorBandBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="2,0,2,0"
                            CornerRadius="2" />
                    <Rectangle x:Name="NowLine"
                               Width="2"
                               Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Border x:Name="NowTag"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="3"
                            Padding="4,0">
                      <TextBlock FontSize="10"
                                 Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                 Text="{Binding NowLabel}" />
                    </Border>
                  </Canvas>
                </Grid>
              </ScrollViewer>
            </Grid>

            <Grid Margin="0,14,0,0" ColumnDefinitions="*,132,Auto" ColumnSpacing="12">
              <Slider Grid.Column="0"
                      Minimum="0"
                      Maximum="1425"
                      TickFrequency="15"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Value="{Binding CursorMinutes, Mode=TwoWay}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{Binding CursorReadout}" />
              <Button Grid.Column="2"
                      Command="{Binding BackToNowCommand}"
                      Content="{loc:Localize Tool.WorldClock.BackToNow}" />
            </Grid>

            <StackPanel Margin="0,14,0,0"
                        Spacing="2"
                        IsVisible="{Binding HasTimelineNotes}">
              <TextBlock Classes="footnote warning"
                         IsVisible="{Binding HasZoneNote}"
                         Text="{Binding ZoneNote}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          IsVisible="{Binding HasHolidayNote}">
                <TextBlock Classes="footnote warning" Text="{Binding HolidayNote}" />
                <HyperlinkButton FontSize="11"
                                 IsVisible="{Binding CanRetryHolidays}"
                                 Command="{Binding RetryHolidaysCommand}"
                                 Content="{loc:Localize Common.Retry}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
