<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:JiuMi"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="JiuMi.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <!-- Backdrop gradients reproduce the prototype's 148° Mica simulation; their relative
           endpoints are the CSS 148° line converted for a 1200 x 760 window (ADR-0006). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="JiuMiComingSoonForegroundBrush" Color="{DynamicResource TextFillColorSecondary}" />
          <SolidColorBrush x:Key="JiuMiComingSoonBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <SolidColorBrush x:Key="JiuMiComingSoonBackgroundBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
          <SolidColorBrush x:Key="JiuMiIslandBackgroundBrush" Color="#9EFFFFFF" />
          <SolidColorBrush x:Key="JiuMiIslandBorderBrush" Color="#B3FFFFFF" />
          <BoxShadows x:Key="JiuMiIslandShadow">0 6 22 0 #24141E32</BoxShadows>
          <LinearGradientBrush x:Key="JiuMiWindowBackdropBrush"
                               StartPoint="21.8%,-21.4%"
                               EndPoint="78.3%,121.4%">
            <GradientStop Offset="0" Color="#E4ECF7" />
            <GradientStop Offset="0.38" Color="#D8E2F0" />
            <GradientStop Offset="0.72" Color="#E7E1F1" />
            <GradientStop Offset="1" Color="#F2E9E3" />
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="JiuMiWindowHighlightBrush"
                               Center="10%,-12%"
                               GradientOrigin="10%,-12%"
                               RadiusX="75%"
                               RadiusY="65%">
            <GradientStop Offset="0" Color="#F3F8FF" />
            <GradientStop Offset="1" Color="#00F3F8FF" />
          </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="JiuMiComingSoonForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="JiuMiComingSoonBorderBrush"
                           Color="{DynamicResource SystemAccentColor}"
                           Opacity="0.42" />
          <SolidColorBrush x:Key="JiuMiComingSoonBackgroundBrush"
                           Color="{DynamicResource SystemAccentColor}"
                           Opacity="0.14" />
          <SolidColorBrush x:Key="JiuMiIslandBackgroundBrush" Color="#8C2E3038" />
          <SolidColorBrush x:Key="JiuMiIslandBorderBrush" Color="#1AFFFFFF" />
          <BoxShadows x:Key="JiuMiIslandShadow">0 8 26 0 #73000000</BoxShadows>
          <LinearGradientBrush x:Key="JiuMiWindowBackdropBrush"
                               StartPoint="21.8%,-21.4%"
                               EndPoint="78.3%,121.4%">
            <GradientStop Offset="0" Color="#141B25" />
            <GradientStop Offset="0.4" Color="#0D131A" />
            <GradientStop Offset="0.74" Color="#181420" />
            <GradientStop Offset="1" Color="#1F1916" />
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="JiuMiWindowHighlightBrush"
                               Center="10%,-12%"
                               GradientOrigin="10%,-12%"
                               RadiusX="75%"
                               RadiusY="65%">
            <GradientStop Offset="0" Color="#223044" />
            <GradientStop Offset="1" Color="#00223044" />
          </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static styling:FluentAvaloniaTheme.HighContrastTheme}">
          <SolidColorBrush x:Key="JiuMiIslandBackgroundBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="JiuMiIslandBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
          <BoxShadows x:Key="JiuMiIslandShadow">0 0 0 0 #00000000</BoxShadows>
          <SolidColorBrush x:Key="JiuMiWindowBackdropBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
          <SolidColorBrush x:Key="JiuMiWindowHighlightBrush" Color="Transparent" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ControlTheme x:Key="ComingSoonBadgeTheme" TargetType="ContentControl">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource JiuMiComingSoonForegroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource JiuMiComingSoonBackgroundBrush}"
                    BorderBrush="{DynamicResource JiuMiComingSoonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="6,2"
                    VerticalAlignment="Center">
              <ContentPresenter Content="{TemplateBinding Content}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="NavigationItemTheme" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
        <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Name="NavItemBackground" Background="{TemplateBinding Background}" CornerRadius="4">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Border>
              <Border Name="NavItemIndicator"
                      Width="3"
                      Height="16"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      CornerRadius="2"
                      IsVisible="False"
                      Background="{DynamicResource AccentFillColorDefaultBrush}" />
              <Border Name="NavItemFocus"
                      BorderThickness="2"
                      CornerRadius="4"
                      IsVisible="False"
                      BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#NavItemBackground">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#NavItemBackground">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#NavItemIndicator">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#NavItemFocus">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled /template/ Border#NavItemBackground">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <styling:FluentAvaloniaTheme />
    <StyleInclude Source="avares://JiuMi/Styles/ShellStyles.axaml" />
  </Application.Styles>
</Application>
