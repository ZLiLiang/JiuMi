<fa:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:fa="using:FluentAvalonia.UI.Windowing"
                 xmlns:vm="using:JiuMi.ViewModels"
                 x:Class="JiuMi.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="{Binding AppName}"
                 Width="1200"
                 Height="760"
                 MinWidth="900"
                 MinHeight="600"
                 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 TransparencyLevelHint="Mica">
  <Grid RowDefinitions="40,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="16,0" Background="Transparent">
      <Border Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
            <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark1}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <TextBlock Grid.Column="1"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{Binding AppName}" />
    </Grid>

    <Grid Grid.Row="1" Background="Transparent" />
  </Grid>
</fa:FAAppWindow>
