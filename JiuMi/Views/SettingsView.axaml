<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:JiuMi.Localization"
             xmlns:vm="using:JiuMi.ViewModels"
             x:Class="JiuMi.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Padding="44,32,44,36">
    <Grid MaxWidth="800" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{loc:Localize Settings.Title}" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="{loc:Localize Settings.Subtitle}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
